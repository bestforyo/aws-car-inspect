/* 鉴见 · 车辆检测 —— 全局设计 Token 与基础样式 */
page {
  --brand-900: #172E39;
  --brand-800: #203B42;
  --primary: #376D57;
  --primary-deep: #264C40;
  --accent: #D7ED9F;
  --canvas: #F5F7F5;
  --surface: #FFFFFF;
  --text: #23343E;
  --muted: #8D999C;
  --line: #E9EDEB;
  --warning: #BD8851;
  --return: #C87861;
  --success: #64866D;
  --radius-card: 24rpx;
  --radius-control: 14rpx;
  --shadow-card: 0 12rpx 40rpx rgba(34, 52, 62, 0.05);

  min-height: 100%;
  background: var(--canvas);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

view, text, scroll-view, button, input, textarea { box-sizing: border-box; }

.page { min-height: 100vh; padding: 32rpx 28rpx 200rpx; }
.eyebrow { font-size: 20rpx; letter-spacing: 2rpx; color: var(--muted); text-transform: uppercase; font-weight: 600; }
.h1 { font-size: 44rpx; font-weight: 700; color: var(--brand-900); line-height: 1.25; }
.h2 { font-size: 34rpx; font-weight: 700; color: var(--brand-900); }
.h3 { font-size: 30rpx; font-weight: 600; color: var(--brand-900); }
.muted { color: var(--muted); font-size: 24rpx; }
.desc { color: var(--muted); font-size: 26rpx; line-height: 1.6; }

.card { background: var(--surface); border-radius: var(--radius-card); box-shadow: var(--shadow-card); padding: 28rpx; }
.card + .card { margin-top: 24rpx; }

.btn { display: flex; align-items: center; justify-content: center; min-height: 88rpx; border-radius: var(--radius-control); font-size: 30rpx; font-weight: 600; border: none; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-primary[disabled] { opacity: 0.5; }
.btn-ghost { background: transparent; color: var(--primary); border: 2rpx solid var(--line); }
.btn-block { width: 100%; }

.row { display: flex; align-items: center; }
.row-between { display: flex; align-items: center; justify-content: space-between; }
.col { display: flex; flex-direction: column; }
.gap-8 { gap: 8rpx; } .gap-16 { gap: 16rpx; } .gap-24 { gap: 24rpx; }
.flex-1 { flex: 1; }

.tag { display: inline-flex; align-items: center; padding: 6rpx 16rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; }
.tag-success { background: rgba(100,134,109,0.14); color: var(--success); }
.tag-warning { background: rgba(189,136,81,0.14); color: var(--warning); }
.tag-return { background: rgba(200,120,97,0.14); color: var(--return); }
.tag-muted { background: rgba(141,153,156,0.14); color: var(--muted); }

.divider { height: 1rpx; background: var(--line); margin: 24rpx 0; }
.safe-bottom { padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom); }
