.head { margin-bottom: 24rpx; }
.head .h1 { margin-top: 8rpx; }
.member { padding: 24rpx 28rpx; }
.m-name { font-size: 30rpx; font-weight: 700; color: var(--brand-900); }
.m-uid { font-size: 20rpx; color: var(--muted); margin-top: 6rpx; word-break: break-all; }
.m-actions { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid var(--line); }
.role-switch { display: flex; gap: 16rpx; }
.role-switch text { font-size: 22rpx; color: var(--primary); }
.note-card { margin-top: 24rpx; }
.note-card .h3 { margin: 8rpx 0; }
.empty { text-align: center; padding: 48rpx; }
