.head { margin-bottom: 24rpx; }
.head .h1 { margin-top: 8rpx; }
.filter-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.fchip { padding: 12rpx 28rpx; background: #fff; border-radius: 999rpx; color: var(--muted); font-size: 26rpx; }
.fchip.active { background: var(--primary); color: #fff; }
.tpl { padding: 24rpx 28rpx; }
.t-name { font-size: 30rpx; font-weight: 700; color: var(--brand-900); }
.t-desc { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; }
.t-meta { font-size: 22rpx; color: var(--primary); margin-top: 10rpx; }
.module-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 14rpx; }
.module-tags text { font-size: 20rpx; color: var(--muted); background: var(--canvas); padding: 6rpx 12rpx; border-radius: 6rpx; }
.note-card { margin-top: 24rpx; }
.note-card .h3 { margin: 8rpx 0; }
