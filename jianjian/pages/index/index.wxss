.home { background: var(--canvas); }
.hero { position: relative; overflow: hidden; background: linear-gradient(135deg, #172E39 0%, #264C40 100%); padding: 48rpx 36rpx 200rpx; border-radius: 0 0 40rpx 40rpx; }
.hero-track { position: absolute; right: -80rpx; top: -60rpx; width: 360rpx; height: 360rpx; border: 2rpx solid rgba(215,237,159,0.28); border-radius: 50%; }
.hero-track::after { content: ''; position: absolute; inset: 60rpx; border: 2rpx solid rgba(215,237,159,0.18); border-radius: 50%; }
.hero-inner { position: relative; z-index: 1; }
.hero-eyebrow { color: var(--accent); font-size: 20rpx; letter-spacing: 3rpx; font-weight: 600; }
.hero-title { color: #fff; font-size: 46rpx; font-weight: 700; margin-top: 16rpx; }
.hero-sub { color: rgba(255,255,255,0.72); font-size: 26rpx; margin-top: 8rpx; }
.hero-meta { display: flex; gap: 16rpx; margin-top: 28rpx; }
.hero-chip { font-size: 22rpx; color: var(--brand-900); background: var(--accent); padding: 8rpx 20rpx; border-radius: 999rpx; font-weight: 600; }
.hero-chip.ghost { background: rgba(255,255,255,0.12); color: rgba(255,255,255,0.85); }
.home-body { padding: 0 28rpx 200rpx; margin-top: -140rpx; position: relative; z-index: 2; }
.section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 24rpx 4rpx 20rpx; }
.section-head .eyebrow { color: var(--muted); }
.entry-grid { display: flex; flex-direction: column; gap: 20rpx; }
.entry { position: relative; border-radius: var(--radius-card); padding: 32rpx; box-shadow: var(--shadow-card); }
.entry.car { background: #E6EFE3; }
.entry.moto { background: #DDE8E8; }
.entry-icon { font-size: 56rpx; }
.entry-title { font-size: 36rpx; font-weight: 700; color: var(--brand-900); margin-top: 12rpx; }
.entry-desc { font-size: 24rpx; color: #5E726E; margin-top: 6rpx; }
.entry-arrow { position: absolute; right: 32rpx; top: 50%; transform: translateY(-50%); font-size: 44rpx; color: var(--primary); }
.lookup { margin-top: 28rpx; }
.lookup-row { display: flex; gap: 16rpx; margin-top: 20rpx; }
.lookup-input { flex: 1; min-height: 80rpx; background: var(--canvas); border-radius: var(--radius-control); padding: 0 24rpx; font-size: 26rpx; }
.lookup-btn { width: 140rpx; min-height: 80rpx; line-height: 80rpx; background: var(--primary); color: #fff; font-size: 28rpx; border-radius: var(--radius-control); margin: 0; }
.lookup-msg { margin-top: 16rpx; font-size: 24rpx; color: var(--warning); }
.stat-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20rpx; margin-top: 28rpx; }
.stat { text-align: center; padding: 28rpx; }
.stat-num { font-size: 52rpx; font-weight: 700; color: var(--primary); }
.stat-label { font-size: 24rpx; color: var(--muted); margin-top: 4rpx; }
.recent-head { margin-top: 40rpx; }
.more { font-size: 24rpx; color: var(--primary); }
.empty { text-align: center; padding: 48rpx; }
.empty-icon { font-size: 64rpx; }
.order-card { padding: 24rpx 28rpx; }
.order-no { font-size: 24rpx; color: var(--muted); letter-spacing: 1rpx; }
.order-title { font-size: 30rpx; font-weight: 600; color: var(--brand-900); margin: 12rpx 0; }
.order-foot { display: flex; justify-content: space-between; font-size: 22rpx; color: var(--muted); }
.disclaimer { font-size: 20rpx; color: var(--muted); line-height: 1.6; text-align: center; margin-top: 40rpx; padding: 0 20rpx; }
