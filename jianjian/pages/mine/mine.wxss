.profile { display: flex; align-items: center; gap: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: var(--primary); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 44rpx; font-weight: 700; }
.profile-info .h3 { margin-bottom: 6rpx; }
.workspace { margin-top: 24rpx; }
.group { margin-top: 32rpx; }
.group-title { font-size: 24rpx; color: var(--muted); margin: 0 4rpx 12rpx; }
.menu { padding: 8rpx 0; }
.menu-item { display: flex; align-items: center; gap: 18rpx; padding: 24rpx 28rpx; font-size: 28rpx; }
.menu-item + .menu-item { border-top: 1rpx solid var(--line); }
.menu-item .arrow { color: var(--muted); }
.menu-item.logout { color: var(--return); }
.version { text-align: center; font-size: 20rpx; color: var(--muted); margin-top: 48rpx; }
