.head { margin-bottom: 24rpx; }
.head .h1 { margin-top: 8rpx; }
.head .desc { margin-top: 8rpx; }
.form-card .field-label { font-size: 24rpx; color: var(--muted); margin: 16rpx 0 8rpx; }
.field { width: 100%; min-height: 84rpx; background: var(--canvas); border-radius: var(--radius-control); padding: 20rpx 24rpx; font-size: 28rpx; }
.textarea { min-height: 160rpx; }
.logo-preview { margin-top: 20rpx; }
.logo-preview image { width: 160rpx; height: 160rpx; background: var(--canvas); border-radius: 12rpx; }
.save-btn { margin-top: 28rpx; }
.summary-row { display: flex; justify-content: space-between; font-size: 26rpx; padding: 14rpx 0; border-bottom: 1rpx solid var(--line); }
.summary-row text:first-child { color: var(--muted); }
