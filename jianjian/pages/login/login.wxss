.login-page { min-height: 100vh; padding: 80rpx 40rpx; background: linear-gradient(160deg, #172E39 0%, #203B42 45%, #F5F7F5 45.2%); }
.brand-block { text-align: center; margin-bottom: 56rpx; }
.brand-mark { display: inline-flex; width: 96rpx; height: 96rpx; align-items: center; justify-content: center; border-radius: 24rpx; background: var(--accent); color: #172E39; font-size: 48rpx; font-weight: 800; }
.brand-name { color: #fff; font-size: 52rpx; font-weight: 700; margin-top: 20rpx; letter-spacing: 4rpx; }
.brand-en { color: var(--accent); font-size: 20rpx; letter-spacing: 4rpx; margin-top: 6rpx; }
.brand-sub { color: rgba(255,255,255,0.6); font-size: 22rpx; margin-top: 20rpx; }
.login-card, .setup-card { position: relative; }
.login-btn { margin-top: 28rpx; }
.error-tip { color: var(--return); font-size: 24rpx; margin-top: 16rpx; }
.demo-tip { color: var(--muted); font-size: 22rpx; line-height: 1.6; margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.user-line { font-size: 26rpx; color: var(--muted); margin: 12rpx 0 24rpx; }
.tab-row { display: flex; border-bottom: 1rpx solid var(--line); margin-bottom: 24rpx; }
.tab { flex: 1; text-align: center; padding: 18rpx 0; color: var(--muted); font-size: 28rpx; }
.tab.active { color: var(--primary); font-weight: 700; border-bottom: 4rpx solid var(--primary); }
.field { width: 100%; min-height: 84rpx; background: var(--canvas); border-radius: var(--radius-control); padding: 20rpx 24rpx; font-size: 28rpx; margin-bottom: 20rpx; }
.small { font-size: 22rpx; margin: 8rpx 0 24rpx; }
