.stepper { display: flex; align-items: center; padding: 20rpx 0 36rpx; }
.step { display: flex; align-items: center; gap: 10rpx; font-size: 22rpx; color: var(--muted); white-space: nowrap; }
.step text { display: inline-flex; width: 40rpx; height: 40rpx; border-radius: 50%; background: var(--line); color: var(--muted); align-items: center; justify-content: center; font-size: 22rpx; }
.step.done { color: var(--primary); font-weight: 600; }
.step.done text { background: var(--primary); color: #fff; }
.step-line { flex: 1; height: 2rpx; background: var(--line); margin: 0 12rpx; }
.step-body .h2 { margin-top: 8rpx; }
.step-body .desc { margin: 8rpx 0 28rpx; }
.form-card { margin-top: 24rpx; }
.field-label { font-size: 24rpx; color: var(--muted); margin: 12rpx 0 8rpx; }
.field { width: 100%; min-height: 84rpx; background: var(--canvas); border-radius: var(--radius-control); padding: 0 24rpx; font-size: 28rpx; }
.kind-row { display: flex; gap: 16rpx; margin-top: 8rpx; }
.kind-chip { flex: 1; text-align: center; padding: 24rpx; border-radius: var(--radius-control); background: var(--canvas); color: var(--muted); font-size: 28rpx; }
.kind-chip.active { background: var(--primary); color: #fff; font-weight: 600; }
.next-btn { margin-top: 32rpx; margin-bottom: 40rpx; }
.standard-list, .package-list { display: flex; flex-direction: column; gap: 20rpx; margin-top: 24rpx; }
.standard-card { position: relative; background: #E6EFE3; border-radius: var(--radius-card); padding: 32rpx 100rpx 32rpx 32rpx; box-shadow: var(--shadow-card); }
.standard-card.group { background: #DDE8E8; }
.std-badge { display: inline-flex; background: var(--primary); color: #fff; font-size: 22rpx; font-weight: 700; padding: 6rpx 14rpx; border-radius: 8rpx; }
.std-title { font-size: 32rpx; font-weight: 700; color: var(--brand-900); margin-top: 16rpx; }
.std-desc { font-size: 24rpx; color: #5E726E; margin-top: 8rpx; }
.std-arrow, .pkg-arrow { position: absolute; right: 28rpx; top: 50%; transform: translateY(-50%); font-size: 40rpx; color: var(--primary); }
.package-card { position: relative; background: var(--surface); border-radius: var(--radius-card); padding: 30rpx 92rpx 30rpx 30rpx; box-shadow: var(--shadow-card); }
.package-card.disabled { opacity: 0.6; }
.pkg-title { font-size: 32rpx; font-weight: 700; color: var(--brand-900); }
.pkg-desc { font-size: 24rpx; color: var(--muted); margin-top: 8rpx; line-height: 1.5; }
.pkg-meta { font-size: 22rpx; color: var(--primary); margin-top: 12rpx; }
.pkg-building { position: absolute; right: 24rpx; top: 50%; transform: translateY(-50%); font-size: 20rpx; color: var(--warning); width: 120rpx; text-align: right; line-height: 1.4; }
