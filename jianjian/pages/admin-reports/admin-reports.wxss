.head { margin-bottom: 24rpx; }
.head .h1 { margin-top: 8rpx; }
.report-card { padding: 26rpx 28rpx; }
.r-no { font-size: 24rpx; color: var(--muted); }
.r-title { font-size: 30rpx; font-weight: 700; color: var(--brand-900); margin: 10rpx 0 6rpx; }
.r-time { font-size: 22rpx; color: var(--muted); }
.mini-btn { margin-top: 18rpx; min-height: 72rpx; font-size: 26rpx; }
.shares { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid var(--line); }
.shares-head { font-size: 24rpx; color: var(--muted); margin-bottom: 12rpx; }
.share-row { display: flex; align-items: center; flex-wrap: wrap; padding: 12rpx 0; border-bottom: 1rpx solid var(--line); }
.s-token { font-size: 22rpx; color: var(--primary-deep); word-break: break-all; width: 100%; }
.s-meta { font-size: 20rpx; color: var(--muted); flex: 1; }
.revoke { font-size: 22rpx; color: var(--return); }
.new-token { margin-top: 16rpx; padding: 16rpx; background: var(--canvas); border-radius: 10rpx; }
.nt-label { font-size: 20rpx; color: var(--muted); }
.nt-code { font-size: 24rpx; word-break: break-all; margin: 10rpx 0; color: var(--primary); }
.empty { text-align: center; padding: 48rpx; }
